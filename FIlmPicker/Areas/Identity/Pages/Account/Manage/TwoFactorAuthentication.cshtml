@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Двухфакторная аутентификация";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <strong>У вас не осталось кодов востановления.</strong>
                    <p>Вам нужно <a asp-page="./GenerateRecoveryCodes">сгенерировать новый набор кодов авторизации</a> перед тем как вы войдете с помощью кода восстановления.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <strong>У вас остался один код восстановления.</strong>
                    <p>Вам нужно <a asp-page="./GenerateRecoveryCodes">сгенерировать новый набор кодов восстановления</a>.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <strong>У вас осталось @Model.RecoveryCodesLeft кодов восстановления.</strong>
                    <p>Вам нужно <a asp-page="./GenerateRecoveryCodes">сгенерировать новый набор кодов восстановления</a>.</p>
                </div>
            }

            if (Model.IsMachineRemembered)
            {
                <form method="post" style="display: inline-block">
                    <button type="submit" class="btn btn-primary">Забыть этот браузер</button>
                </form>
            }
            <a asp-page="./Disable2fa" class="btn btn-primary">Выключить 2FA</a>
            <a asp-page="./GenerateRecoveryCodes" class="btn btn-primary">Сбросить коды восстановления</a>
        }

        <h4>Аутентификаторы</h4>
        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Добавить аутентификатор</a>
        }
        else
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Подключить аутентификатор</a>
            <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-primary">Сбросить аутентификатор</a>
        }
    }
    else
    {
        <div class="alert alert-danger">
            <strong>Privacy and cookie policy have not been accepted.</strong>
            <p>You must accept the policy before you can enable two factor authentication.</p>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
