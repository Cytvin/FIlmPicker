@using FIlmPicker.Models
@model List<Room>
@{
    ViewData["Title"] = "Приглашения";
}

<h1>Приглашения</h1>
<hr />
<div>
    @if (Model.Count == 0)
    {
        <h3 class="text-center">Нет новых приглашений</h3>
    }

    @foreach (Room room in Model)
    {
        <div class="card">
            <div class="card-body">
                <form method="post" asp-controller="Invitations" asp-action="Update">
                    <input type="hidden" name="id" value="@room.Id">

                    <p class="card-text">Приглашение в комнату от @room.Owner.UserName</p>
                    <button class="btn btn-primary" name="button" type="submit" value="accept">Принять</button>
                    <button class="btn btn-danger" name="button" type="submit" value="reject">Отклонить</button>
                </form>
            </div>
        </div>
    }
</div>