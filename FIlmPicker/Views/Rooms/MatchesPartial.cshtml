@using FIlmPicker.Models
@model List<Movie>

<body>
    <div class="container p-1 m-0">
        @if (Model.Count > 0)
        {
            @foreach (Movie movie in Model)
            {
                <div class="card">
                    <div class="card-body">
                        <h5>@movie.Name (@movie.Year) KP:@movie.KpRaiting
                            <a href="https://kinopoisk.ru/film/@movie.Id">Кинопоиск</a>
                        </h5> 
                    </div>
                </div>
            }
        }
        else
        {
            <h5 class="text-center">Нет совпадений</h5>
        }
    </div>
</body>
