@using FIlmPicker.Models
@model RoomViewModel

@{
    ViewData["Title"] = "Подбор фильмов";
}

<div class="modal fade" tabindex="-1" id="outFromRoom" aria-labelledby="outFromRoomLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form class="d-inline" method="post" asp-controller="Rooms" asp-action="Out">
                <div class="modal-header">
                    <h5>Покинуть комнату с @Model.SecondUserName?</h5>
                </div>
                
                <div class="modal-body">
                    <a>После выхода из комнаты вы не сможете в неё вернуться. 
                       Создание новой комнаты с пользователем "@Model.SecondUserName" будет недоступно, пока он не покинет комнату.
                       Если вы создатель комнаты и "@Model.SecondUserName" еще не принял приглашение, то после выхода из комнаты она будет удалена.</a>
                </div>
                
                <input name="id" type="hidden" value="@Model.RoomId" />

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Покинуть</button>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Отмена</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row border-bottom border-dark m-1">
    <div class="col">
        <h1>Комната с @Model.SecondUserName</h1>
    </div>
</div>

<ul class="nav nav-pills nav-fill border-bottom border-dark p-1">
    <li class="nav-item">
        <a class="nav-link" asp-controller="RoomSettings" asp-action="Index" asp-route-id="@Model.RoomId">Настройки</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Rooms" asp-action="Matches" asp-route-id="@Model.RoomId">Совпадения</a>
    </li>
    <li class="nav-item">
        <a class="nav-link link-danger" data-bs-target="#outFromRoom" href="#outFromRoom" data-bs-toggle="modal">Покинуть комнату</a>
    </li>
</ul>

<div class="mt-2">
    @if (Model.StatusOK)
    {
        <form id="scoreMovieForm" method="post" asp-controller="Rooms" asp-action="ScoreMovie">
            <div id="filmImage" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img class="d-block m-auto" src="@Model.Movie.Poster" />
                    </div>
                </div>
                <button name="score" class="carousel-control-prev bg-danger" type="submit" value="Dislike">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Не нравится</span>
                </button>
                <button name="score" class="carousel-control-next bg-success" type="submit" value="Like">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Нравится</span>
                </button>
            </div>

            <input type="hidden" name="roomId" value="@Model.RoomId" />
            <input type="hidden" name="movieKpId" value="@Model.Movie.Id" />
            <h5 class="text-center">@Model.Movie.Name
                <span class="badge bg-secondary">@Model.Movie.KpRaiting</span>
            </h5>
            <h5 class="text-center">Год: @Model.Movie.Year Длительность: @Model.Movie.MovieLength мин.</h5>
            <h5 class="text-center">Жанры: 
                @foreach (Genre genre in Model.Movie.Genres)
                {
                    @String.Format("{0} ", genre.Name)
                }
            </h5>
            <p class="text-center">@Model.Movie.Description</p>
        </form>
    }
    else
    {
        <h3 class="text-center">@Model.StatusMessage</h3>
    }
</div>