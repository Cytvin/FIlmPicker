@using FIlmPicker.Models
@model RoomViewModel

@{
    ViewData["Title"] = "Подбор фильмов";
}

<div class="row">
    <div class="col">
        <a asp-controller="RoomSettings" asp-action="Index" asp-route-id="@Model.RoomId">Настройки</a>
    </div>
    <div class="col">
        <a asp-controller="Rooms" asp-action="Matches" asp-route-id="@Model.RoomId">Совпадения</a>
    </div>
    <div class="col">
        <form method="post" asp-controller="Rooms" asp-action="Out">
            <input name="id" type="hidden" value="@Model.RoomId" />
            <button class="btn btn-link text-danger" type="submit">Выход</button>
        </form>
    </div>
</div>

<div>
    @if (Model.StatusOK)
    {
        <form id="scoreMovieForm" method="post" asp-controller="Rooms" asp-action="ScoreMovie">
            <h3 class="text-center">Комната с @Model.SecondUserName</h3>

            <div class="m-1 row m-0">
                <div class="col text-start">
                    <button name="score" class="btn btn-danger" type="submit" value="Dislike">Не нравится</button>
                </div>
                <div class="col text-end">
                    <button name="score" class="btn btn-primary text-end" type="submit" value="Like">Нравится</button>
                </div>
            </div>

            <input type="hidden" name="roomId" value="@Model.RoomId" />
            <input type="hidden" name="movieKpId" value="@Model.Movie.Id" />
            <img class="justify-content-center" src="@Model.Movie.Poster" style="width:300px; height:500px" />
            <p class="text-center">@Model.Movie.Name</p>
            <p class="text-center">@Model.Movie.Description</p>
        </form>
    }
    else
    {
        <h3 class="text-center">@Model.StatusMessage</h3>
    }
</div>