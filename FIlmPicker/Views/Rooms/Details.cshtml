@using FIlmPicker.Models
@model RoomViewModel

@{
    ViewData["Title"] = "Подбор фильмов";
}

<div class="row">
    <div class="col">
        <form method="post" asp-controller="RoomSettings" asp-action="Index">
            <input name="id" type="hidden" value="@Model.RoomId"/>
            <button class="btn btn-link" type="submit">Настройки</button>
        </form>
    </div>
    <div class="col">
        <form method="post" asp-controller="Rooms" asp-action="Out">
            <input name="id" type="hidden" value="@Model.RoomId" />
            <button class="btn btn-link text-danger" type="submit">Выход</button>
        </form>
    </div>
</div>