@using FIlmPicker.Models
@model MatchesViewModel

@{
    ViewData["Title"] = "Совпадения";
}

<div class="row border-bottom border-dark m-1">
    <div class="col">
        <h1>Совпадения с @Model.SecondUserName</h1>
    </div>
</div>

<ul class="nav nav-pills nav-fill border-bottom border-dark p-1">
    <li class="nav-item">
        <a class="nav-link" asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.Room.Id">Перейти в комнату</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Rooms" asp-action="Index">Перейти к списку комнат</a>
    </li>
</ul>

<div class="mt-2">
    @if (Model.Movies.Count() > 0)
    {
        @foreach (Movie movie in Model.Movies)
        {
            <div class="row border border-dark bg-white shadow-sm m-1 mt-2 mb-2 p-2 rounded-3">
                <div class="col-9">
                    <h4>@movie.Name (@movie.Year) KP:@movie.KpRaiting</h4>
                </div>
                <div class="col-3">
                    <div class="float-end">
                        <h4><a href="https://kinopoisk.ru/film/@movie.Id">Кинопоиск</a></h4>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <h5 class="text-center">Нет совпадений</h5>
    }
</div>