@using FIlmPicker.Models
@model List<Movie>

@{
    ViewData["Title"] = "Совпадения";
}

<h4>Совпадения с </h4>
<hr />
<div>
    @if (Model.Count > 0)
    {
        @foreach (Movie movie in Model)
        {
            <div class="card">
                <div class="card-body">
                    <h5>
                        @movie.Name (@movie.Year) KP:@movie.KpRaiting
                        <a href="https://kinopoisk.ru/film/@movie.Id">Кинопоиск</a>
                    </h5>
                </div>
            </div>
        }
    }
    else
    {
        <h5 class="text-center">Нет совпадений</h5>
    }
</div>