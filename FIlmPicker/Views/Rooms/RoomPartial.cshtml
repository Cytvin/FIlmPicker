@using FIlmPicker.Models
@model RoomViewModel

<div>
    @if (Model != null)
    {
        <form id="scoreMovieForm" method="post" asp-controller="Rooms" asp-action="ScoreMovie">
            <h3 class="text-center">Комната с @Model.SecondUserName</h3>

            <div class="m-1 row m-0">
                <div class="col text-start">
                    <a class="btn btn-danger" href="javascript:dislikeMovie()">Не нравится</a>
                </div>
                <div class="col text-end">
                    <a class="btn btn-primary text-end" href="javascript:likeMovie()">Нравится</a>
                </div>
            </div>

            <input type="hidden" name="roomId" value="@Model.RoomId" />
            <input type="hidden" name="movieKpId" value="@Model.Movie.Id" />
            <img class="justify-content-center" src="@Model.Movie.Poster" style="width:300px; height:500px" />
            <p class="text-center">@Model.Movie.Name</p>
            <p class="text-center">@Model.Movie.Description</p>
        </form>
    }
    else
    {
        <h3 class="text-center">@ViewBag.Message</h3>
    }
</div>