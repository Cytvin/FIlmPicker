@using FIlmPicker.Models
@model RoomsViewModel

@{
    ViewData["Title"] = "Комнаты";
    int itemNumber = 0;
}

<div class="modal fade" tabindex="-1" id="createRoom" aria-labelledby="createRoomLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Rooms" asp-action="Create">

                <div class="modal-header">
                    <h5>Создание комнаты</h5>
                </div>

                <div class="modal-body">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">@@</span>
                        <input type="text" class="form-control" placeholder="Введите логин друга" aria-label="Username" aria-describedby="basic-addon1" name="guestLogin">
                        <a>Вашему другу будет направлено приглашение, которое он должен будет принять</a>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Создать</button>
                </div>
            </form>
        </div>
    </div>
</div>

<a data-bs-target="#createRoom" href="#createRoom" data-bs-toggle="modal">
    <p>Создать комнату</p>
</a>

<div class="row">
    <div class="col-md-3">
        @if (Model.UnacceptedInviteCount > 0)
        {
            <div class="card">
                <div class="card-body">
                    <div class="card-header">
                        <div class="row">
                            <h5 class="card-text col">Приглашения</h5>
                            <span class="badge bg-primary col-2">@Model.UnacceptedInviteCount</span>
                        </div>
                    </div>
                    <a class="stretched-link text-decoration-none" asp-controller="Invitations" asp-action="Index"></a>
                </div>
            </div>
        }

        @if (Model.Rooms.Count() > 0)
        {
            <h5 class="text-center">Ваши комнаты</h5>
            <div class="accordion" id="ownerRoomAccordion">
                @foreach (Room room in Model.Rooms)
                {
                    itemNumber++;

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading-@itemNumber">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@itemNumber" aria-expanded="false" aria-controls="collapse-@itemNumber">
                                Комната с @room.Guest.UserName
                            </button>
                        </h2>
                        <div id="collapse-@itemNumber" class="accordion-collapse collapsed collapse" aria-labelledby="heading-@itemNumber" data-bs-parent="#ownerRoomAccordion">
                            <div class="accordion-body">
                                <div>
                                    <form method="get" asp-controller="Rooms" asp-action="Details">
                                        <input type="hidden" name="id" value="@room.Id" />
                                        <button class="btn btn-link p-0 shadow-none" type="submit">Подбор фильмов</button>
                                    </form>
                                </div>
                                <div>
                                    <a href="#" onclick="getMatches('@room.Id')">Просмотр совпадений</a>
                                </div>
                                <div>
                                    <a href="#" onclick="getSettings('@room.Id')">Настройки</a>
                                </div>
                                <div>
                                    <form method="post" asp-controller="Rooms" asp-action="Out">
                                        <input type="hidden" name="id" value="@room.Id" />
                                        <button class="text-danger btn btn-link p-0 shadow-none" type="submit">Покинуть</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <div class="col-md-9" id="roomData">

    </div>
</div>