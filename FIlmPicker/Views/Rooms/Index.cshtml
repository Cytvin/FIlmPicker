@using FIlmPicker.Models
@model RoomsViewModel

@{
    ViewData["Title"] = "Комнаты";
}

<div class="modal fade" tabindex="-1" id="createRoom" aria-labelledby="createRoomLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Rooms" asp-action="Create">

                <div class="modal-header">
                    <h5>Создание комнаты</h5>
                </div>

                <div class="modal-body">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">@@</span>
                        <input type="text" class="form-control" placeholder="Введите логин друга" aria-label="Username" aria-describedby="basic-addon1" name="guestLogin">
                        <a>Вашему другу будет направлено приглашение, которое он должен будет принять</a>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Создать</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row border-bottom border-dark m-1">
    <div class="col">
        <h1>Комнаты</h1>
    </div>
    <div class="col">
        <a class="btn btn-lg btn-link shadow-none float-end" data-bs-target="#createRoom" href="#createRoom" data-bs-toggle="modal">Создать комнату</a>
    </div>
</div>

<div>
    @if (Model.UnacceptedInviteCount > 0)
    {
        <div class="card">
            <div class="card-body">
                <div class="card-header">
                    <div class="row">
                        <h5 class="card-text col">Приглашения</h5>
                        <span class="badge bg-primary col-2">@Model.UnacceptedInviteCount</span>
                    </div>
                </div>
                <a class="stretched-link text-decoration-none" asp-controller="Invitations" asp-action="Index"></a>
            </div>
        </div>
    }

    @foreach (Room room in Model.Rooms)
    {
        <div class="row border border-dark bg-white shadow-sm m-1 mt-2 mb-2 p-2 rounded-3">
            <div class="col-4">
                <h4>Комната с @room.Guest.UserName</h4>
            </div>
            <div class="col-8">
                <div class="float-end">
                    <a class="d-inline" asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id">Подбор фильмов</a> | 
                    <a class="d-inline" asp-controller="RoomSettings" asp-action="Index" asp-route-id="@room.Id">Настройки</a> | 
                    <a class="d-inline" asp-controller="Rooms" asp-action="Matches" asp-route-id="@room.Id">Совпадения</a>
                </div>
            </div>
        </div>
    }
</div>