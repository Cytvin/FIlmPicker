@using Microsoft.AspNetCore.Identity
@using FIlmPicker.Models

@{
    ViewData["Title"] = "Главная";
}

<div class="d-flex h-100 align-items-center justify-content-center flex-column">
    <div class="d-flex border border-dark bg-white shadow rounded-3 h-50 w-75 flex-column justify-content-center">
        <div class="align-self-center self">
            <h1>Добро пожаловать</h1>
        </div>
        <a class="btn btn-primary mt-2 mb-2 w-50 align-self-center" asp-area="Identity" asp-page="/Account/Login">Вход</a>
        <a class="btn btn-primary mt-2 mb-2 w-50 align-self-center" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
    </div>
</div>