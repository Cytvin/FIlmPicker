@{
    ViewData["Title"] = "Home Page";
}
@using Microsoft.AspNetCore.Identity
@using FIlmPicker.Data.Models
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model List<Room>

<div class="container">
    @if (SignInManager.IsSignedIn(User))
    {
        <h1 class="display-4 text-center">Welcome @User.Identity?.Name</h1>
        <p class="text-center">Ваш ID: @ViewBag.Id</p>
        <p class="text-center">Количество комнат: @Model.Count</p>
        @if (Model?.Count > 0)
        {
            <p>У вас есть @Model.Count комнат!</p>
        }
        else
        {
            <div class="container">
                <div class="row justify-content-center">
                    <div class="card ms-2 me-2 col-4 shadow">
                        <div class="card-body">
                            <a class="stretched-link text-decoration-none" href="">
                                <p class="card-text text-center text-black">Создать комнату</p>
                            </a>
                        </div>
                    </div>
                    <div class="card ms-2 me-2 col-4 shadow">
                        <div class="card-body">
                            <a class="stretched-link text-decoration-none" href="">
                                <p class="card-text text-center text-black">Просмотреть приглашения</p>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <h2 class="display-4 text-center">Необходима авторизация</h2>
    }
</div>
